# 复制到项目根目录 .env，再填写本机配置。此文件不含真实凭据。
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=loopback
SITE_URL=http://localhost:3000
SCHOOL_NAME=示例学校

DB_HOST=localhost
DB_PORT=3306
DB_USER=campus_wall
DB_PASSWORD=
DB_NAME=campus_wall
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

# 必填：自行生成随机值；为空时应用拒绝启动。
JWT_SECRET=
SHUTDOWN_TIMEOUT_MS=240000

# 可选服务；未配置时不启用真实外部调用。
# WECHAT_APPID=
# WECHAT_SECRET=
# WECHAT_TOKEN=
# WECHAT_ENCODING_AES_KEY=
# CLOUDBASE_ENV_ID=
# CLOUDBASE_APIKEY=
# GLM_API_KEY=
# DASHSCOPE_API_KEY=
# DEPLOY_SECRET=

# 运行 deploy.sh 前必须配置自己的发布仓库，公开版没有默认生产地址。
# DEPLOY_REPO_URL=https://example.com/your-project.git

# 可选天气位置；不设置时不请求真实天气服务。
# WEATHER_CITY=
# WEATHER_LATITUDE=
# WEATHER_LONGITUDE=
